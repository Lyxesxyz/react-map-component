{
  "name": "geospatial-map-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter geospatial-map-demo dev",
    "build": "pnpm --filter @org/geospatial-map build && pnpm --filter geospatial-map-demo build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
