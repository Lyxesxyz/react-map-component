---
// The site's own icons, drawn on a 24 × 24 grid in the current text colour: the two frameworks'
// marks, and line icons for what the map does (Starlight's built-in set has neither). Decorative
// unless `label` is given.
interface Props {
  name: keyof typeof glyphs
  size?: string
  label?: string
  class?: string
}

const glyphs = {
  // The frameworks' marks, in one colour.
  react: `<g transform="translate(12 12)"><circle r="2.05" fill="currentColor"/><g fill="none" stroke="currentColor" stroke-width="1.1"><ellipse rx="10.6" ry="4.05"/><ellipse rx="10.6" ry="4.05" transform="rotate(60)"/><ellipse rx="10.6" ry="4.05" transform="rotate(120)"/></g></g>`,
  angular: `<path fill="currentColor" d="M9.93 12.645h4.134L11.996 7.74M11.996.009.686 3.988l1.725 14.76 9.585 5.243 9.588-5.238L23.308 3.99 11.996.01zm7.058 18.297h-2.636l-1.42-3.501H8.995l-1.42 3.501H4.937l7.06-15.648 7.057 15.648z"/>`,
  // A folded map: the examples.
  examples: `<path d="M9 4 3.5 6v14L9 18l6 2 5.5-2V4L15 6z"/><path d="M9 4v14M15 6v14"/>`,
  // Equal Earth, with its central meridian and the equator.
  projection: `<path d="M18.37 17.23 18.93 16.98 20.1 16.32 21.21 15.42 22.06 14.35 22.57 13.2 22.75 12 22.57 10.8 22.06 9.65 21.21 8.58 20.1 7.68 18.93 7.02 18.37 6.77H5.63L5.07 7.02 3.9 7.68 2.79 8.58 1.94 9.65 1.43 10.8 1.25 12 1.43 13.2 1.94 14.35 2.79 15.42 3.9 16.32 5.07 16.98 5.63 17.23Z"/><path d="M1.25 12h21.5M12 6.77v10.46M8.82 17.23 8.53 16.98 7.95 16.32 7.39 15.42 6.97 14.35 6.71 13.2 6.63 12 6.71 10.8 6.97 9.65 7.39 8.58 7.95 7.68 8.53 7.02 8.82 6.77M15.18 17.23 15.47 16.98 16.05 16.32 16.61 15.42 17.03 14.35 17.29 13.2 17.38 12 17.29 10.8 17.03 9.65 16.61 8.58 16.05 7.68 15.47 7.02 15.18 6.77" opacity=".55"/>`,
  data: `<ellipse cx="12" cy="5.5" rx="7.5" ry="2.75"/><path d="M4.5 5.5v13c0 1.5 3.4 2.75 7.5 2.75s7.5-1.25 7.5-2.75v-13"/><path d="M4.5 12c0 1.5 3.4 2.75 7.5 2.75s7.5-1.25 7.5-2.75"/>`,
  symbols: `<circle cx="4" cy="17.5" r="2"/><circle cx="10.25" cy="16.25" r="3.25"/><circle cx="18.25" cy="14.75" r="4.75"/><path d="M1.5 21h21"/>`,
  layers: `<path d="M12 3 3 7.5l9 4.5 9-4.5z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>`,
  time: `<circle cx="12" cy="12" r="9"/><path d="M10 8.5v7l5.5-3.5z"/>`,
  raster: `<rect x="3.5" y="3.5" width="17" height="17" rx="2"/><path d="M3.5 9.17h17M3.5 14.83h17M9.17 3.5v17M14.83 3.5v17"/><path d="M9.17 9.17h5.66v5.66H9.17zM14.83 14.83h5.67v3.67a2 2 0 0 1-2 2h-3.67z" fill="currentColor" stroke="none" opacity=".4"/>`,
  grid: `<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M8.83 5v14M15.17 5v14M2.5 12h19"/>`,
  export: `<path d="M12 3.5v11"/><path d="m7.5 10 4.5 4.5 4.5-4.5"/><path d="M4 16.5v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>`,
  theme: `<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/>`,
  compose: `<rect x="3" y="3.5" width="18" height="17" rx="2"/><path d="M3 9h18M9 9v11.5"/>`,
  error: `<path d="M10.27 4.2 2.6 17.5a2 2 0 0 0 1.73 3h15.34a2 2 0 0 0 1.73-3L13.73 4.2a2 2 0 0 0-3.46 0z"/><path d="M12 9.5v4M12 17h.01"/>`,
  language: `<path d="M4 5.5h9M8.5 3.5v2M6 5.5c.6 3 2.6 6 6 7.5M11 5.5c-.6 3-2.6 6-6 8"/><path d="m12 20.5 4.5-10 4.5 10M13.6 17h5.8"/>`,
  external: `<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>`,
  github: `<path fill="currentColor" stroke="none" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"/>`,
} as const

const { name, size = '1em', label, class: className } = Astro.props
---

<svg
  class:list={['glyph', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={glyphs[name]}
/>

<style>
  .glyph {
    flex: none;
    vertical-align: middle;
  }
</style>
