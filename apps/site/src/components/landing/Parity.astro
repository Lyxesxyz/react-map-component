---
// Landing page: the two folders side by side (the root README's "Choose React or Angular").
import { branch, repository } from '../../../site.config.mjs'
import Glyph from '../Glyph.astro'
import { frameworkIds, frameworkLabels, sitePath } from '../demo-url'
import { folderOf, version } from '../sources'

const rows = [
  {
    label: 'Framework',
    react: 'React 18.3 or 19',
    angular: 'Angular 21 or 22, zoneless or with zone.js',
  },
  {
    label: 'The map',
    react:
      '<code>&lt;GeospatialMap&gt;</code>, or <code>&lt;MapRoot&gt;</code> with the parts you want',
    angular:
      '<code>&lt;geo-map&gt;</code>, or <code>&lt;geo-map-root&gt;</code> with the parts you want',
  },
  { label: 'Icons', react: '<code>lucide-react</code>', angular: '<code>lucide</code>' },
]
---

<section class="landing-section not-content parity" aria-labelledby="parity">
  <div class="landing-heading">
    <h2 id="parity">One map, two frameworks</h2>
    <p>
      Both folders are release {version} and have the same features. The engine, the configuration,
      the types and the stylesheet are the same files, byte for byte, in both. They render the same
      elements, <code>geo-*</code> classes, roles and labels, and one browser suite runs against
      both demos. A configuration, a theme or a stylesheet written for one works in the other.
    </p>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <td></td>
          {frameworkIds.map((id) => (
            <th scope="col">
              <a href={sitePath(`${id}/`)}>
                <Glyph name={id} size="1.125rem" />
                {frameworkLabels[id]}
              </a>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Folder to copy</th>
          {frameworkIds.map((id) => (
            <td>
              <a class="path" href={`${repository}/tree/${branch}/${folderOf(id)}`}>
                <code set:html={folderOf(id).replaceAll('/', '/<wbr>')} />
              </a>
            </td>
          ))}
        </tr>
        {rows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            <td set:html={row.react} />
            <td set:html={row.angular} />
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .parity {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 64rem) {
    .parity {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: 3rem;
    }
  }

  .table-wrap {
    border: 1px solid var(--site-line);
    border-radius: var(--site-radius);
    background: var(--site-surface);
    overflow: hidden;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    table-layout: fixed;
  }

  th,
  td {
    padding: 0.875rem 1rem;
    text-align: start;
    vertical-align: top;
    color: var(--sl-color-gray-2);
  }

  thead td,
  tbody th {
    width: 8.5rem;
  }

  tbody tr {
    border-top: 1px solid var(--site-line);
  }

  thead th {
    padding-block: 0.75rem;
    font-size: var(--sl-text-base);
  }

  thead a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  thead a:hover {
    color: var(--sl-color-text-accent);
  }

  tbody th {
    color: var(--sl-color-gray-3);
    font-weight: 500;
  }

  .path {
    color: inherit;
    text-decoration: none;
  }

  .path:hover code {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  td :global(code) {
    white-space: nowrap;
  }

  .path :global(code) {
    white-space: normal;
  }

  /* Phones: each row's name above its two cells. */
  @media (max-width: 40rem) {
    thead tr,
    tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    thead td {
      display: none;
    }
    tbody th {
      grid-column: 1 / -1;
      width: auto;
      padding-bottom: 0;
    }
    th,
    td {
      padding: 0.625rem 0.875rem;
    }
  }
</style>
