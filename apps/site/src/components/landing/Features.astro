---
// Landing page: what the map does, each with the example that shows it (src/data/examples.mjs).
import { examples } from '../../data/examples.mjs'
import Glyph from '../Glyph.astro'
import { sitePath } from '../demo-url'

const features = [
  {
    icon: 'projection',
    title: 'Equal Earth by default',
    text: 'Maps open in Equal Earth. Web Mercator and the projection of your ArcGIS basemap work too.',
    example: 'global',
  },
  {
    icon: 'data',
    title: 'Indicator data from anywhere',
    text: 'GeoJSON, CSV, JSON rows, ArcGIS feature layers and ArcGIS Online items, by URL or from memory.',
    example: 'arcgis',
  },
  {
    icon: 'symbols',
    title: 'Symbology',
    text: 'Graduated classes, categories, continuous ramps, bubbles and heatmaps, for polygons, lines and points.',
    example: 'points',
  },
  {
    icon: 'layers',
    title: 'Layer panel and legends',
    text: 'Visibility, opacity, order and metadata for each layer, in groups, with a legend for each.',
    example: 'layers',
  },
  {
    icon: 'time',
    title: 'Time playback',
    text: 'Play or step layers through time frames, with a speed control and a legend for each frame.',
    example: 'time',
  },
  {
    icon: 'raster',
    title: 'Raster and tiled layers',
    text: 'XYZ, WMS, WMTS and vector tiles next to your vector layers, each with its own opacity.',
    example: 'raster',
  },
  {
    icon: 'grid',
    title: 'A 3 × 2 map grid',
    text: 'Six maps with synchronised layers and time, each one focusable, for report pages.',
    example: 'grid',
  },
  {
    icon: 'export',
    title: 'Export',
    text: 'PNG, JPEG or SVG, with the legend, from the settings panel or from your code.',
    example: 'global',
  },
  {
    icon: 'theme',
    title: 'Themes in CSS',
    text: '<code>--geo-*</code> tokens, dark mode, and recipes for Material 3, IBM Carbon and editorial themes.',
    example: 'themes',
  },
  {
    icon: 'compose',
    title: 'Your own layout',
    text: 'Use the ready-made layout, or compose the parts you want and add parts of your own.',
    example: 'composed',
  },
  {
    icon: 'error',
    title: 'Errors stay contained',
    text: 'A layer that fails to load shows its error while the rest of the map keeps working.',
    example: 'errors',
  },
  {
    icon: 'language',
    title: 'Your words, any language',
    text: 'Every label and message can be replaced; the playground switches the map to Bulgarian.',
    example: 'configuration',
  },
] as const

const titleOf = (id: string) => {
  const example = examples.find((candidate) => candidate.id === id)
  if (!example) throw new Error(`Features: no example "${id}" in src/data/examples.mjs`)
  return example.title
}
---

<section class="landing-section not-content" aria-labelledby="features">
  <div class="landing-heading">
    <h2 id="features">What the map does</h2>
    <p>Each of these runs live in an example, in both frameworks.</p>
  </div>
  <ul class="features" role="list">
    {features.map((feature) => (
      <li>
        <a href={sitePath(`examples/${feature.example}/`)}>
          <span class="icon">
            <Glyph name={feature.icon} size="1.25rem" />
          </span>
          <span class="title">{feature.title}</span>
          <span class="text" set:html={feature.text} />
          <span class="example">Example: {titleOf(feature.example)}</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--site-line);
    border-radius: var(--site-radius);
    background: var(--site-line);
    overflow: hidden;
  }

  li {
    display: flex;
    background: var(--sl-color-bg);
  }

  a {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.375rem;
    width: 100%;
    padding: 1.25rem 1.25rem 1.125rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  a:hover {
    background: var(--site-surface);
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.5rem;
    border: 1px solid var(--site-line);
    border-radius: 0.625rem;
    background: var(--site-surface);
    color: var(--sl-color-text-accent);
  }

  .title {
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .text {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .example {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }

  a:hover .example,
  a:focus-visible .example {
    color: var(--sl-color-text-accent);
  }

  /* Phones: the icon beside the text, so twelve features don't make a long scroll. */
  @media (max-width: 40rem) {
    a {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      grid-template-rows: none;
      column-gap: 1rem;
      padding: 1rem;
    }
    .icon {
      grid-row: span 3;
      margin-bottom: 0;
    }
    .example {
      margin-top: 0.375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a {
      transition: none;
    }
  }
</style>
