---
// Landing page: every page made from a folder's Markdown (src/guides), per framework, in the
// sidebar's order. A guide is listed by its title, the other pages by their sidebar label.
import { getCollection } from 'astro:content'
import FrameworkTabs from '../FrameworkTabs.astro'
import { frameworkIds, sitePath, type Framework } from '../demo-url'
import { folderOf } from '../sources'

const linksOf = async (framework: Framework) => {
  const entries = await getCollection('docs', (entry) => entry.data.framework === framework)
  return entries
    .sort((a, b) => (a.data.sidebar.order ?? 0) - (b.data.sidebar.order ?? 0))
    .map((entry) => {
      const source = typeof entry.data.editUrl === 'string' ? entry.data.editUrl : ''
      const file = source.split(`/${folderOf(framework)}/`)[1] ?? ''
      const guide = entry.id.startsWith(`${framework}/guides/`)
      return {
        href: sitePath(`${entry.id}/`),
        title: guide ? entry.data.title : (entry.data.sidebar.label ?? entry.data.title),
        file,
      }
    })
}

const links = Object.fromEntries(
  await Promise.all(frameworkIds.map(async (id) => [id, await linksOf(id)] as const)),
) as Record<Framework, { href: string; title: string; file: string }[]>
---

<section class="landing-section not-content guides" aria-labelledby="guides">
  <div class="landing-heading">
    <h2 id="guides">Read the guides</h2>
    <p>
      The guides travel with the folder, in its <code>README.md</code> and <code>docs/</code>, so
      your copy has them too. These pages are the same files.
    </p>
  </div>
  <FrameworkTabs>
    {frameworkIds.map((id) => (
      <ul slot={id} class="guide-list" role="list">
        {links[id].map((link) => (
          <li>
            <a href={link.href}>
              <span class="title">{link.title}</span>
              <span class="file">{link.file}</span>
            </a>
          </li>
        ))}
      </ul>
    ))}
  </FrameworkTabs>
</section>

<style>
  .guide-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 0 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    border-bottom: 1px solid var(--site-line);
  }

  a {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    width: 100%;
    padding: 0.875rem 0.25rem;
    color: var(--sl-color-white);
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
  }

  a:hover .title {
    color: var(--sl-color-text-accent);
  }

  a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .file {
    color: var(--sl-color-gray-3);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 400;
  }
</style>
