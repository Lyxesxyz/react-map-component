---
// One example in the gallery: a small map plate (the world in Equal Earth) with the example's
// legend on it, its title (the link to its page) and its summary. The plate is three masks
// (src/assets/plate-*.svg) painted in the theme's colours, so every card shares three small files.
import landMask from '../../assets/plate-land.svg?url'
import linesMask from '../../assets/plate-lines.svg?url'
import sphereMask from '../../assets/plate-sphere.svg?url'
import type { Example } from '../../data/examples.mjs'
import { sitePath } from '../demo-url'
import MiniLegend from './MiniLegend.astro'

interface Props {
  example: Example
}

const { example } = Astro.props
const masks = [
  `--sphere: url(${JSON.stringify(sphereMask)})`,
  `--land: url(${JSON.stringify(landMask)})`,
  `--lines: url(${JSON.stringify(linesMask)})`,
].join('; ')
---

<article class="example-card">
  <div class="plate">
    <div class="world" style={masks} aria-hidden="true">
      <span class="sphere"></span>
      <span class="land"></span>
      <span class="lines"></span>
    </div>
    <MiniLegend shows={example.shows} />
  </div>
  <div class="body">
    <h2>
      <a href={sitePath(`examples/${example.id}/`)}>{example.title}</a>
    </h2>
    <p>{example.summary}</p>
  </div>
</article>

<style>
  .example-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--site-line);
    border-radius: var(--site-radius);
    background: var(--sl-color-bg);
    transition: border-color 150ms ease;
  }

  .example-card:hover {
    border-color: color-mix(in srgb, var(--sl-color-text-accent) 55%, var(--site-line));
  }

  .example-card:has(a:focus-visible) {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .plate {
    position: relative;
    height: 9.5rem;
    border-bottom: 1px solid var(--site-line);
    background: var(--plate-band);
  }

  .world {
    position: absolute;
    inset: 0.75rem 1rem;
  }

  .world > span {
    position: absolute;
    inset: 0;
    -webkit-mask: var(--mask) center / contain no-repeat;
    mask: var(--mask) center / contain no-repeat;
  }

  .sphere {
    --mask: var(--sphere);
    background: var(--plate-ocean);
  }

  .land {
    --mask: var(--land);
    background: var(--plate-land);
  }

  .lines {
    --mask: var(--lines);
    background: var(--plate-line);
  }

  .plate :global(.mini-legend) {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
  }

  .body {
    display: grid;
    gap: 0.375rem;
    padding: 1rem 1.125rem 1.25rem;
  }

  h2 {
    margin: 0;
    font-size: var(--sl-text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  h2 a {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  /* The whole card is the link's target. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  h2 a:focus-visible {
    outline: none;
  }

  .example-card:hover h2 a {
    color: var(--sl-color-text-accent);
  }

  p {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .example-card {
      transition: none;
    }
  }
</style>
